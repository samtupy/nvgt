/**
	Retrieve the sound_environment_source of a sound or mixer attached to this environment, which holds its settings and simulation results.
	sound_environment_source@ sound_environment::get_source(mixer@+ sound_or_mixer) const;
	## Arguments:
		* mixer@+ sound_or_mixer: the sound or mixer to look up.
	## Returns:
		sound_environment_source@: the source, or null if the object isn't attached to this environment.
*/

// Example:
void main() {
	sound_environment env;
	mixer@ m = env.new_mixer();
	sound_environment_source@ src = env.get_source(m);
	src.apply_reflections = false; // This mixer's sounds are heard without reverb.
}
