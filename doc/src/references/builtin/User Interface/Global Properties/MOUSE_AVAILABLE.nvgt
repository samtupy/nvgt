/**
	Determines whether a mouse is connected to the device.
	const bool MOUSE_AVAILABLE;
	## Remarks:
		This property only reports accurate information once your game window has been shown with `show_window()`. Before that, it reads false even if a mouse is connected.
		To list the connected mice, see `get_mice()`.
*/

// Example:
void main() {
	show_window("Example");
	alert("Mouse", MOUSE_AVAILABLE ? "A mouse is connected." : "No mouse is connected.");
}
