/**
	Shows a window with the specified title.
	game_window@ show_window(const string&in title, uint flags = 0);
	## Arguments:
		* const string&in title: the title of the window.
		* uint flags: An optional set of flags to control the window's appearance. This can be a combination of values from the `window_flags` enum.
	## Returns:
		game_window@: the main window, or null if it couldn't be created.
	## Remarks:
		If the main window already exists, its title is changed and it is shown if it was hidden, rather than a second window being created. The window is also available afterwards through the global window property.
		This window doesn't do any event processing by default. As such, you have to create a loop in order to keep it alive, calling wait() or refresh_window() regularly.
*/

// Example:
void main() {
	alert("Info", "Press escape to close the window.");
	show_window("Example", WINDOW_FLAG_RESIZABLE | WINDOW_FLAG_MAXIMIZED);
	while (true) {
		wait(5); // Don't hog all the CPU.
		if (key_pressed(KEY_ESCAPE))
			exit();
	}
}
