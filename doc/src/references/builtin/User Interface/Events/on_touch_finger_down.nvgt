/**
	An event that is fired whenever a finger touches a touch device.
	engine_touch_event on_touch_finger_down;
	## Listener signatures:
		* bool callback(uint64 device, const touch_finger& finger);
		* void callback(uint64 device, const touch_finger& finger);
		* A class implementing engine_touch_event_listener, with a `bool on_touch_finger_down(uint64 device, const touch_finger& finger)` or `void on_touch_finger_down(uint64 device, const touch_finger& finger)` method.
	## Arguments passed to listeners:
		* uint64 device: the ID of the touch device, which can be passed to functions such as `get_touch_device_name()` and `query_touch_device()`.
		* const touch_finger& finger: the finger that touched the device. Its id stays the same until the finger is lifted, x and y are its position from 0 to 1 across the device, and pressure is how hard it is pressing.
	## Remarks:
		The finger parameter must be declared exactly as `const touch_finger& finger`. Writing `const touch_finger&in finger` causes a "No matching signatures" error when adding the listener.
		See the Events topic for how listeners are added, ordered and removed, and what their return values mean.
*/

// Example:
void on_down(uint64 device, const touch_finger& finger) {
	screen_reader_output("Touched at " + round(finger.x * 100, 0) + " percent across, " + round(finger.y * 100, 0) + " percent down", true);
}
void main() {
	show_window("Example");
	on_touch_finger_down += on_down;
	wait(50); // Give screen readers time to speak the window title.
	screen_reader_output("Touch the screen to hear where you touched it. Press escape or back to exit.", true);
	while (!key_pressed(KEY_ESCAPE) and !key_pressed(KEY_AC_BACK)) wait(5);
}
