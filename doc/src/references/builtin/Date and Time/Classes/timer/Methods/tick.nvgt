/**
	Check whether a given amount of time has passed, and if it has, start the timer over.
	bool timer::tick(int64 time_units);
	## Arguments:
		* int64 time_units: the amount of time that must be elapsed, in units of the timer's accuracy.
	## Returns:
		bool: true if at least time_units had elapsed, in which case the timer has been restarted.
	## Remarks:
		This is the most convenient way of using the timer object. Usually the goal is to check if a given time has elapsed repeatedly, be it a weapon firing many times over, footsteps several times a second or many other types of repeating events. You can use the `timer::has_elapsed()` method to check if a timer has elapsed the given duration, but then you must manually restart the timer each time which adds an extra line to your code per check. This does both steps in one call.
*/

// Example:
void main() {
	timer t;
	int ticks = 0;
	while (ticks < 3) {
		if (t.tick(1000)) { // the following only executes if 1000 milliseconds has elapsed.
			ticks++; // The timer has been restarted for us already when the tick() function returned true.
			alert("Example", "Tick " + ticks);
		}
		wait(1);
	}
}
