/**
	Get the position and rotation of a body together.
	physics_transform physics_world::get_transform(const physics_body_id&in id) const;
	## Arguments:
		* const physics_body_id&in id: the body to operate on, as returned by `create_and_add_body()`.
	## Returns:
		physics_transform: the body's position and rotation.
*/

// Example:
void main() {
	physics_world world;
	physics_body_id crate = world.create_and_add_body(physics_box_shape_create(vector(0.5, 0.5, 0.5)), vector(1, 2, 3), IDENTITY_QUATERNION, PHYSICS_BODY_STATIC, PHYSICS_LAYER_NON_MOVING);
	physics_transform t = world.get_transform(crate);
	alert("Transform", "The crate is at " + t.position);
}
