/**
	The result code of the most recent sound system operation that reported one.
	const audio_error_state SOUNDSYSTEM_LAST_ERROR;
	## Remarks:
		This is one of the values in the `audio_error_state` enum. It is `AUDIO_ERROR_STATE_SUCCESS` (0) if the most recent operation succeeded, and a negative value if it failed.
		Not every audio function updates this value, and some functions fail before reaching the point where it is set. It is most useful right after a call that returned false, such as `sound::load()`, to find out why. Use `SOUNDSYSTEM_LAST_ERROR_TEXT` to get a description of the error.
*/

// Example:
void main() {
	sound s;
	if (!s.load("this_file_does_not_exist.ogg"))
		alert("Unable to load the sound", "Error code " + SOUNDSYSTEM_LAST_ERROR + ": " + SOUNDSYSTEM_LAST_ERROR_TEXT);
}
