/**
	Move a listener of the default engine, the point that 3d sounds are heard from.
	bool sound_set_listener_position(float x, float y, float z, uint listener_index = 0);
	bool sound_set_listener_position(const vector&in position, uint listener_index = 0);
	## Arguments:
		* float x, float y, float z (1): the new position.
		* const vector&in position (2): the new position.
		* uint listener_index = 0: the listener to move. Most games only use listener 0.
	## Returns:
		bool: true if the listener was moved, false if the sound system couldn't be started.
	## Remarks:
		Call this whenever the player moves, so that sounds are heard from where they are. This is the same as `sound_default_engine.set_listener_position()`, and the direction the listener faces is set with `audio_engine::set_listener_direction()`.
*/

// Example:
void main() {
	sound s;
	s.load("C:/Windows/media/ding.wav");
	s.set_position_3d(0, 5, 0);
	s.play_wait();
	sound_set_listener_position(10, 5, 0); // Now the sound is to the left.
	s.play_wait();
}
