/**
	A filter that keeps only the frequencies around its cutoff, removing those above and below.
	audio_band_pass_filter(double cutoff_frequency, uint order, audio_engine@ engine = sound_default_engine);
	## Arguments:
		* double cutoff_frequency: the frequency in hertz at the center of the band that is kept.
		* uint order: how narrow the band is and how steeply frequencies outside it are cut, see `order`.
		* audio_engine@ engine = sound_default_engine: the engine to create the node in.
	## Remarks:
		This is an audio_node with one input and one output bus, and has all of the methods and properties of audio_node as well as the ones listed here. Its settings can be changed while audio is playing.
		This gives the sound of a radio or an old telephone line.
*/

// Example:
void main() {
	sound s;
	s.load("C:/Windows/media/ding.wav");
	audio_band_pass_filter effect(1000, 2);
	s.effects_chain.add_node(effect);
	s.play_wait();
}
