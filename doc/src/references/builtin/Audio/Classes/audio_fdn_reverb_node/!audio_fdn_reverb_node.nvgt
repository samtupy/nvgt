/**
	A feedback delay network reverb, derived from the reverb of Synthizer, with a smooth tail and separate decay times for low, middle and high frequencies.
	audio_fdn_reverb_node(audio_engine@+ engine = sound_default_engine);
	## Arguments:
		* audio_engine@+ engine = sound_default_engine: the engine to create the node in.
	## Remarks:
		This is an audio_node with one input and one output bus, and has all of the methods and properties of audio_node as well as the ones listed here. Audio attached to its input comes out of its output with reverb added. The input is mixed to mono before it is reverberated, and the reverb is stereo.
		Compared to audio_freeverb_node it sounds smoother and less metallic, and its properties describe a room in physical terms: `mean_free_path` for its size, `t60` for how long it rings, and `lf_rolloff` and `hf_rolloff` for how its walls treat low and high frequencies. It is still being tested, so its defaults and the way some of its properties sound may change in future versions.
		Unlike audio_freeverb_node, this node passes its input through unchanged by default, with a `dry` level of 1. Set `dry` to 0 when giving it to a reverb3d, as the sounds sent to it are already heard directly.
		The reverb keeps sounding after its input stops, for about `tail_length` seconds, and it continues to do so even when nothing is attached to its input. Changes to its properties take effect smoothly without clicks, so they can be made while audio is playing, such as when the player walks from a small room into a hall.
*/

// Example:
void main() {
	audio_fdn_reverb_node hall;
	hall.dry = 0;
	hall.mean_free_path = 0.05;
	hall.t60 = 2.5;
	hall.hf_rolloff = 0.4; // The highs die away faster than the rest, like a real hall.
	reverb3d verb(hall);
	sound s;
	s.load("C:/Windows/media/ding.wav");
	@s.reverb3d = verb;
	s.set_position_3d(0, 15, 0);
	s.play_wait();
	wait(int(hall.tail_length * 1000));
}
