/**
	A reverb effect based on the classic Freeverb algorithm, which makes audio sound as though it is in a room.
	audio_freeverb_node(audio_engine@ engine = sound_default_engine);
	## Arguments:
		* audio_engine@ engine = sound_default_engine: the engine to create the node in.
	## Remarks:
		This is an audio_node with one input and one output bus, and has all of the methods and properties of audio_node as well as the ones listed here. Audio attached to its input comes out of its output with reverb added.
		Freeverb is cheap and simple to set up, needing little more than a `room_size` and `damping`, but it can sound somewhat metallic, especially on short sharp sounds. audio_fdn_reverb_node is a smoother sounding alternative with more control.
		By default the node only outputs the reverb and none of its input, which is what is wanted when it is given to a reverb3d, the usual way to use a reverb in a 3d game, as the sounds sent to it are heard directly as well. To put a sound through the reverb alone, set `dry` so that the sound itself is still heard.
*/

// Example:
void main() {
	sound s;
	s.load("C:/Windows/media/ding.wav");
	audio_freeverb_node reverb;
	reverb.room_size = 0.9;
	reverb.dry = 0.5; // The sound only goes through the reverb, so let it be heard directly as well.
	s.set_mixer(null);
	s.attach_output_bus(0, reverb, 0);
	reverb.attach_output_bus(0, sound_default_engine.endpoint, 0);
	s.play_wait();
	wait(3000); // Let the reverb ring out.
}
