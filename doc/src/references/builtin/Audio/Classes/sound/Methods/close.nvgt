/**
	Close whatever is loaded into the sound, freeing it so that the sound object can be loaded with something else.
	bool sound::close();
	## Returns:
		bool: true if the sound could be closed, false if nothing was loaded.
	## Remarks:
		Loading something new into a sound closes what was loaded before automatically, so this is only needed to free memory early. A sound is also closed when it is destroyed.
*/

// Example:
void main() {
	sound s;
	s.load("C:/windows/media/ding.wav");
	alert("example", s.close()); // Will display true since a sound was previously opened.
	alert("example", s.close()); // Will now display false since the previous operation freed the sound object of any attached sound.
}
