/**
	Stream a sound from a URL, such as an internet radio station or a sound file on a web server.
	bool sound::stream_url(const string&in url);
	## Arguments:
		* const string&in url: the address of the audio, which should lead directly to the audio data rather than to a web page about it.
	## Returns:
		bool: true if the stream could be opened, false otherwise.
	## Remarks:
		The audio is downloaded and decoded a little at a time as it plays. Live streams such as radio stations have no known length, so their `length` is 0 and they can't be seeked.
		This method should currently be considered beta.
*/

// Example:
void main() {
	sound s;
	bool success = s.stream_url("https://example.com/my_sound.mp3");
	alert("Result", "The sound is " + (success == false? "not " : "") + "ready to stream.");
}
