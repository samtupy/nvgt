/**
	A filter that removes low frequencies below its cutoff, making audio sound thin, such as through a telephone or a small speaker.
	audio_high_pass_filter(double cutoff_frequency, uint order, audio_engine@ engine = sound_default_engine);
	## Arguments:
		* double cutoff_frequency: the frequency in hertz below which audio is removed.
		* uint order: how steeply frequencies below the cutoff are cut, from 1 to 8, see `order`.
		* audio_engine@ engine = sound_default_engine: the engine to create the node in.
	## Remarks:
		This is an audio_node with one input and one output bus, and has all of the methods and properties of audio_node as well as the ones listed here. Its settings can be changed while audio is playing.
		It is also useful for removing rumble from a recording.
*/

// Example:
void main() {
	sound s;
	s.load("C:/Windows/media/ding.wav");
	audio_high_pass_filter effect(1500, 4);
	s.effects_chain.add_node(effect);
	s.play_wait();
}
