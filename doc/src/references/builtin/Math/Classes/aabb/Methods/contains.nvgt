/**
	Check whether a point or another box is inside this box.
	1. bool aabb::contains(const vector&in point) const;
	2. bool aabb::contains(const aabb&in box) const;
	## Arguments:
		* const vector&in point (1): the point to check.
		* const aabb&in box (2): the box to check, which must be entirely inside.
	## Returns:
		bool: true if it is inside.
*/

// Example:
void main() {
	aabb room(vector(0, 0, 0), vector(10, 10, 3));
	vector player(5, 5, 1);
	alert("Inside", room.contains(player) ? "The player is in the room." : "The player is outside.");
}
