/**
	Check whether another box overlaps this one.
	bool aabb::test_collision(const aabb&in other) const;
	## Arguments:
		* const aabb&in other: the box to check.
	## Returns:
		bool: true if any part of the boxes overlap.
	## Remarks:
		This is the same as `overlaps()`.
*/

// Example:
void main() {
	aabb a(vector(0, 0, 0), vector(2, 2, 2));
	aabb b(vector(1, 1, 1), vector(3, 3, 3));
	alert("Collision", a.test_collision(b) ? "The boxes overlap." : "The boxes are apart.");
}
