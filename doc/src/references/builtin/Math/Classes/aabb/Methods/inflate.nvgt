/**
	Make the box bigger on every side.
	void aabb::inflate(float x, float y, float z);
	## Arguments:
		* float x: how far to move the faces perpendicular to the x axis outwards, on both sides.
		* float y: how far to move the faces perpendicular to the y axis outwards.
		* float z: how far to move the faces perpendicular to the z axis outwards.
	## Remarks:
		The box grows by twice each amount along that axis. Negative values shrink it.
*/

// Example:
void main() {
	aabb box(vector(0, 0, 0), vector(1, 1, 1));
	box.inflate(1, 1, 1);
	alert("Size", "The box is now " + box.size.x + " wide."); // 3
}
