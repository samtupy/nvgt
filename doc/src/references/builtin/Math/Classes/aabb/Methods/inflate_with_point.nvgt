/**
	Grow the box so that it contains a point.
	void aabb::inflate_with_point(const vector&in point);
	## Arguments:
		* const vector&in point: the point to include.
	## Remarks:
		This is the same as the first form of `encapsulate()`.
*/

// Example:
void main() {
	aabb box(vector(0, 0, 0), vector(1, 1, 1));
	box.inflate_with_point(vector(5, 0, 0));
	alert("Max", "" + box.max); // 5, 1, 1
}
