/**
	Calculate the dot product of this vector and another.
	float vector::dot(const vector&in other) const;
	## Arguments:
		* const vector&in other: the other vector.
	## Returns:
		float: the dot product.
	## Remarks:
		For two vectors of length 1 the dot product is 1 when they point the same way, 0 when they are at right angles and -1 when they point opposite ways, which makes it useful for finding out whether something is in front of or behind something else.
*/

// Example:
void main() {
	vector facing(0, 1, 0);
	vector to_enemy(0, 5, 0);
	alert("Dot", "The dot product is " + facing.dot(to_enemy)); // Positive, so the enemy is in front.
}
