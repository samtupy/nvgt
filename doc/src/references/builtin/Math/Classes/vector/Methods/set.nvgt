/**
	Set all three coordinates at once.
	void vector::set(float x, float y, float z);
	## Arguments:
		* float x: the new x coordinate.
		* float y: the new y coordinate.
		* float z: the new z coordinate.
*/

// Example:
void main() {
	vector v;
	v.set(1, 2, 3);
	alert("Vector", v.x + ", " + v.y + ", " + v.z);
}
