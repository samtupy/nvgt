/**
	Calculate the cross product of this vector and another.
	vector@ vector::cross(const vector&in other) const;
	## Arguments:
		* const vector&in other: the other vector.
	## Returns:
		vector@: a vector at right angles to both of the originals.
	## Remarks:
		The cross product follows the right hand rule, so with x to the right and y forward the cross product of x with y points up the z axis. Its length is the product of the lengths of the vectors times the sine of the angle between them.
*/

// Example:
void main() {
	vector right(1, 0, 0), forward(0, 1, 0);
	vector up = right.cross(forward);
	alert("Cross", "Up is " + up.x + ", " + up.y + ", " + up.z);
}
