/**
	Calculate the length of the vector.
	float vector::length() const;
	## Returns:
		float: the distance of the vector's point from the origin.
	## Remarks:
		To compare distances it is quicker to use `length_square()` and compare squares.
*/

// Example:
void main() {
	vector v(3, 4, 0);
	alert("Length", "The length is " + v.length()); // 5
}
