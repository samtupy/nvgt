/**
	Overloads the *= operator, multiplying this vector by a number.
	vector& vector::opMulAssign(float scalar);
	## Arguments:
		* float scalar: the number to multiply every coordinate by.
*/

// Example:
void main() {
	vector v(1, 2, 3);
	v *= 2;
	alert("Vector", v.x + ", " + v.y + ", " + v.z);
}
