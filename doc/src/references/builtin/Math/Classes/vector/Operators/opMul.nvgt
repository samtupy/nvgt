/**
	Overloads the * operator, multiplying a vector by a number or by another vector.
	1. vector@ vector::opMul(const vector&in other) const;
	2. vector@ vector::opMul(float scalar) const;
	## Arguments:
		* const vector&in other (1): the vector to multiply by.
		* float scalar (2): the number to multiply every coordinate by.
	## Returns:
		vector@: the product.
	## Remarks:
		Multiplying by a number scales the vector, so multiplying a direction by a distance gives the offset. Multiplying two vectors multiplies each coordinate by the same coordinate of the other, which is not the dot or cross product.
*/

// Example:
void main() {
	vector v1(1, 4, 8);
	vector v2 = v1 * 3;
	alert("The second vector =", "(" + v2.x + ", " + v2.y + ", " + v2.z + ")");
}
