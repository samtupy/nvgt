/**
	Converts the vector to a string.
	string vector::opImplConv() const;
	## Returns:
		string: the vector in the form `vector(x, y, z)`.
	## Remarks:
		This conversion happens automatically when a vector is added to a string, so `"position: " + v` works.
*/

// Example:
void main() {
	vector v(1, 2, 3);
	alert("Vector", "The vector is " + v);
}
