/**
	Overloads the == operator, comparing two vectors.
	bool vector::opEquals(const vector&in other) const;
	## Arguments:
		* const vector&in other: the vector to compare with.
	## Returns:
		bool: true if all three coordinates are equal.
	## Remarks:
		Because coordinates are floating point numbers, vectors that were calculated by different means may differ by a tiny amount even when they ought to be the same.
*/

// Example:
void main() {
	vector a(1, 2, 3), b(1, 2, 3);
	alert("Equal", a == b ? "yes" : "no");
}
