/**
	Overloads the / operator, dividing a vector by a number or by another vector.
	1. vector@ vector::opDiv(const vector&in other) const;
	2. vector@ vector::opDiv(float scalar) const;
	## Arguments:
		* const vector&in other (1): the vector to divide by.
		* float scalar (2): the number to divide every coordinate by.
	## Returns:
		vector@: the quotient.
	## Remarks:
		Dividing two vectors divides each coordinate by the same coordinate of the other.
*/

// Example:
void main() {
	vector v1(10, 20, 30);
	vector v2 = v1 / 10;
	alert("Vector", v2.x + ", " + v2.y + ", " + v2.z);
}
