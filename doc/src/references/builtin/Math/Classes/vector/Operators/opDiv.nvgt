/**
	Overloads the / operator, dividing a vector by a number.
	vector@ vector::opDiv(float scalar) const;
	## Arguments:
		* float scalar: the number to divide every coordinate by.
	## Returns:
		vector@: the quotient.
*/

// Example:
void main() {
	vector v1(10, 20, 30);
	vector v2 = v1 / 10;
	alert("Vector", v2.x + ", " + v2.y + ", " + v2.z);
}
