/**
	Overloads the [] operator, accessing a coordinate by number.
	float vector::opIndex(uint index) const;
	void vector::opIndex(uint index, float value);
	## Arguments:
		* uint index: 0 for x, 1 for y and 2 for z.
		* float value (2): the value to set.
*/

// Example:
void main() {
	vector v(1, 2, 3);
	v[2] = 30;
	alert("Vector", "z is " + v[2]);
}
