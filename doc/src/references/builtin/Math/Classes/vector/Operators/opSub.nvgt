/**
	Overloads the - operator, subtracting a vector from another.
	vector@ vector::opSub(const vector&in other) const;
	## Arguments:
		* const vector&in other: the vector to subtract.
	## Returns:
		vector@: the difference.
	## Remarks:
		Subtracting one position from another gives the vector from the second to the first, whose length is the distance between them.
*/

// Example:
void main() {
	vector player(0, 0, 0), enemy(3, 4, 0);
	vector between = enemy - player;
	alert("Distance", "The enemy is " + between.length() + " meters away.");
}
