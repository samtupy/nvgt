/**
	Overloads the -= operator, subtracting a vector from this one.
	vector& vector::opSubAssign(const vector&in other);
	## Arguments:
		* const vector&in other: the vector to subtract.
*/

// Example:
void main() {
	vector position(10, 10, 10);
	position -= vector(1, 2, 3);
	alert("Position", position.x + ", " + position.y + ", " + position.z);
}
