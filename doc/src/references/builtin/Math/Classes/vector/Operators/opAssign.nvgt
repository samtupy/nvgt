/**
	Overloads the = operator, copying another vector's coordinates into this one.
	vector& vector::opAssign(const vector&in other);
	## Arguments:
		* const vector&in other: the vector to copy.
*/

// Example:
void main() {
	vector a(1, 2, 3), b;
	b = a;
	a.x = 100; // b is unaffected.
	alert("b", b.x + ", " + b.y + ", " + b.z);
}
