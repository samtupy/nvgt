/**
	Make an HTTP GET request and wait for the response.
	string url_get(const string&in url, http_response&out response = void);
	## Arguments:
		* const string&in url: the URL to request, with a scheme of http or https.
		* http_response&out response = void: if given, receives the status and headers of the response.
	## Returns:
		string: the body of the response, or an empty string if the request failed.
	## Remarks:
		This blocks the script until the request finishes, so it is best for small requests where waiting is acceptable. To keep the game running during a request, use the http class, which this function uses.
*/

// Example:
void main() {
	http_response resp;
	string version = url_get("https://nvgt.dev/downloads/latest_version", resp);
	if (resp.status != HTTP_OK) alert("Error", "The request failed with status " + resp.status + ".");
	else alert("Latest NVGT version", version);
}
