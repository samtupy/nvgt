/**
	A username and password for HTTP authentication, which can answer a server's request for authentication with Basic, Digest or NTLM credentials.
	1. http_credentials();
	2. http_credentials(const string&in username, const string&in password);
	## Arguments:
		* const string&in username (2): the username to authenticate with.
		* const string&in password (2): the password to authenticate with.
	## Remarks:
		The http class handles authentication itself when given an http_credentials object, so this class is mainly for use with http_client. When a server responds with HTTP_UNAUTHORIZED, pass the request and that response to authenticate(), which adds the right Authorization header for whichever scheme the server asked for, and send the request again.
*/

// Example:
void main() {
	http_credentials creds("user", "passwd");
	http h;
	h.get("https://httpbin.org/basic-auth/user/passwd", null, creds);
	h.wait();
	alert("Status " + h.status_code, h.response_body);
}
