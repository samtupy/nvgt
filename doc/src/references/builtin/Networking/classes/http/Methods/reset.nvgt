/**
	Cancel the current request, if any, and clear the response.
	void http::reset(bool configuration = false);
	## Arguments:
		* bool configuration = false: whether to also restore the settings, max_retries, retry_delay, keepalive and the timeouts, to their defaults.
	## Remarks:
		This waits for the current request to cancel, which is usually instant, though there can be a short delay while the request's thread reaches a point where it checks for cancellation.
		Starting a new request resets the previous one automatically, and destroying the http object resets it too, so this is only needed to cancel a request or free the memory of its response.
*/

// Example:
void main() {
	http h;
	h.get("https://nvgt.dev");
	wait(20);
	h.reset();
	h.get("https://samtupy.com/ip.php");
	h.wait();
	if (h.status_code != 200) alert("oops " + h.status_code, h.response_body);
	else alert("IP address displayed after http reset", h.response_body);
}
