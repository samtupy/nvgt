/**
	A list of names and values, such as the headers of an HTTP request or the cookies of a website.
	1. name_value_collection();
	2. name_value_collection(const name_value_collection&in other);
	3. $list(int&in) { repeat { string, string } };
	## Arguments:
		* const name_value_collection&in other (2): a collection to copy.
	## Remarks:
		Names are case insensitive, so `c["content-type"]` and `c["Content-Type"]` are the same entry, and a name can appear more than once. A collection can be created from an initialization list of name and value pairs, as in `name_value_collection headers = {{"Accept", "text/html"}, {"Accept-Language", "en"}};`.
		Indexing the collection with a name gets or sets its value, but reading a name that isn't there throws an exception, use get() with a default value to avoid that. Entries keep their order, and name_at() and value_at() access them by position.
		internet_message_header, and through it http_request and http_response, are name_value_collections with more methods, so everything here works with them too. A name_value_collection that is really one of those can be cast to it with cast<internet_message_header@>().
*/

// Example:
void main() {
	name_value_collection c = {{"Name", "Sam"}, {"Game", "NVGT"}};
	c["score"] = "1500";
	c.add("game", "BGT");
	string info = "name: " + c["name"] + "\nlevel: " + c.get("level", "unknown") + "\n" + c.size() + " entries:";
	for (uint i = 0; i < c.size(); i++) info += "\n" + c.name_at(i) + " = " + c.value_at(i);
	alert("Collection", info);
}
