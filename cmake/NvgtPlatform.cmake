# Compiler and linker settings for every target NVGT builds, including plugins. Settings only the engine and its stubs use are on the nvgt_core_options and nvgt_engine targets in the main CMakeLists.txt.
# NVGT - NonVisual Gaming Toolkit (https://nvgt.dev)
# Copyright (c) 2022-2026 Sam Tupy
# license: zlib

if(ANDROID)
	set(NVGT_TARGET android)
elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
	set(NVGT_TARGET ios)
elseif(APPLE)
	set(NVGT_TARGET macos)
elseif(WIN32)
	set(NVGT_TARGET windows)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
	set(NVGT_TARGET linux)
else()
	message(FATAL_ERROR "NVGT can't be built for ${CMAKE_SYSTEM_NAME}.")
endif()

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_BUILD_WITH_INSTALL_RPATH ON) # Only the engine and stubs get an rpath, set in nvgt_link_engine(), rather than every target getting the build tree's library directories.
set(debug "$<CONFIG:Debug>")
set(release "$<NOT:$<CONFIG:Debug>>")
set(cxx "$<COMPILE_LANGUAGE:CXX>")

add_compile_definitions(POCO_STATIC POCO_NO_AUTOMATIC_LIBS PRISM_STATIC "$<IF:${debug},DEBUG,NDEBUG>" UNICODE)
if(NVGT_TARGET STREQUAL "windows")
	set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<${debug}:Debug>")
	add_compile_options(/EHsc /J /utf-8 /Gy /GF /Zc:inline /bigobj /permissive- "$<${debug}:/Od;/Z7>" "$<${release}:/O2;/Gw>")
	if(NVGT_WARNINGS)
		add_compile_options(/W3)
	endif()
	if(NVGT_WARNINGS_AS_ERRORS)
		add_compile_options(/WX)
	endif()
	add_link_options(/MANIFEST:NO /NOEXP "$<$<NOT:$<STREQUAL:$<TARGET_PROPERTY:TYPE>,SHARED_LIBRARY>>:/NOIMPLIB>") # CMake expects a DLL's import library to exist, and puts it in the build directory rather than release/lib.
	set(NVGT_SYSTEM_LIBRARIES Kernel32 User32 imm32 OneCoreUAP dinput8 dxguid gdi32 winspool shell32 iphlpapi ole32 oleaut32 delayimp uuid comdlg32 advapi32 netapi32 winmm version crypt32 bcrypt normaliz wldap32 ws2_32 ntdll secur32)
else()
	if(NVGT_TARGET STREQUAL "android")
		set(optimize -O2)
	else()
		set(optimize -O3)
	endif()
	add_compile_options("$<${cxx}:-fms-extensions;-fpermissive;$<IF:${debug},-O0,${optimize}>;-Wno-narrowing;-Wno-int-to-pointer-cast;-Wno-delete-incomplete;-Wno-unused-result;$<${debug}:-g>>")
	if(NVGT_WARNINGS)
		add_compile_options("$<${cxx}:-Wall;-Wextra>")
	endif()
	if(NVGT_WARNINGS_AS_ERRORS)
		add_compile_options("$<${cxx}:-Werror>")
	endif()
	set(NVGT_SYSTEM_LIBRARIES m)
endif()
if(NVGT_TARGET STREQUAL "ios")
	add_compile_options("$<${cxx}:-xobjective-c++>")
elseif(NVGT_TARGET STREQUAL "linux")
	add_compile_options(-ffunction-sections -fdata-sections)
	add_link_options(-fuse-ld=gold -Wl,--gc-sections "$<IF:${debug},-g,-s>")
elseif(NVGT_TARGET STREQUAL "android")
	add_compile_options(-fPIC "$<${cxx}:-DAS_USE_STLNAMES=1;-ffunction-sections;-Wno-deprecated-array-compare;-Wno-implicit-const-int-float-conversion;-Wno-deprecated-enum-enum-conversion;-Wno-absolute-value>")
	add_link_options(-Wl,--no-fatal-warnings -Wl,--no-undefined -Wl,--gc-sections -Wl,-z,max-page-size=16384) # 16 KB page size support is required by Google Play and by devices using 16 KB pages.
endif()
