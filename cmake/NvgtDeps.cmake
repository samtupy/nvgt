# Locates NVGT's dependencies, a folder such as windev or lindev holding the headers and libraries of everything NVGT links with, downloading or building it first if asked to. nvgt_dep_libraries() then turns library names from that folder into imported targets.
# NVGT - NonVisual Gaming Toolkit (https://nvgt.dev)
# Copyright (c) 2022-2026 Sam Tupy
# license: zlib

set(NVGT_DEPS "download" CACHE STRING "How to get NVGT's dependencies: build them from source with vcpkg, download prebuilt ones from nvgt.dev when newer than the existing copy, or leave whatever is in place unmanaged")
set_property(CACHE NVGT_DEPS PROPERTY STRINGS build download unmanaged)
if(NOT NVGT_DEPS MATCHES "^(build|download|unmanaged)$")
	message(FATAL_ERROR "NVGT_DEPS must be one of build, download or unmanaged, not ${NVGT_DEPS}.")
endif()
set(NVGT_DEPS_PATH "" CACHE PATH "Where NVGT's dependencies are, by default a folder named after the platform such as windev in the repository root")

if(NVGT_TARGET STREQUAL "windows")
	set(NVGT_DEPS_NAME windev)
elseif(NVGT_TARGET STREQUAL "linux")
	set(NVGT_DEPS_NAME lindev)
elseif(NVGT_TARGET STREQUAL "android")
	set(NVGT_DEPS_NAME droidev)
else()
	set(NVGT_DEPS_NAME ${NVGT_TARGET}dev)
endif()
if(NVGT_DEPS_PATH)
	get_filename_component(NVGT_DEPS_DIR "${NVGT_DEPS_PATH}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
else()
	set(NVGT_DEPS_DIR "${CMAKE_SOURCE_DIR}/${NVGT_DEPS_NAME}")
endif()

function(nvgt_download_deps dir)
	set(last_update -1)
	if(EXISTS "${dir}/timestamp")
		file(READ "${dir}/timestamp" last_update)
		string(STRIP "${last_update}" last_update)
	elseif(EXISTS "${dir}/include" AND EXISTS "${dir}/lib")
		return() # The folder looks valid but has no timestamp, so it was not downloaded by us.
	endif()
	set(url "https://nvgt.dev/${NVGT_DEPS_NAME}.zip")
	file(DOWNLOAD "${url}.timestamp" "${CMAKE_BINARY_DIR}/${NVGT_DEPS_NAME}.zip.timestamp" STATUS status)
	list(GET status 0 code)
	if(NOT code EQUAL 0)
		if(EXISTS "${dir}/include")
			message(WARNING "Could not check ${url} for newer dependencies, continuing with the ones in ${dir}.")
			return()
		endif()
		message(FATAL_ERROR "Could not download ${url}.timestamp: ${status}")
	endif()
	file(READ "${CMAKE_BINARY_DIR}/${NVGT_DEPS_NAME}.zip.timestamp" latest)
	string(STRIP "${latest}" latest)
	if(last_update GREATER_EQUAL latest)
		return()
	endif()
	message(STATUS "Downloading ${url}")
	file(DOWNLOAD "${url}" "${CMAKE_BINARY_DIR}/${NVGT_DEPS_NAME}.zip" STATUS status)
	list(GET status 0 code)
	if(NOT code EQUAL 0)
		message(FATAL_ERROR "Could not download ${url}: ${status}")
	endif()
	file(REMOVE_RECURSE "${dir}")
	file(ARCHIVE_EXTRACT INPUT "${CMAKE_BINARY_DIR}/${NVGT_DEPS_NAME}.zip" DESTINATION "${dir}")
	file(REMOVE "${CMAKE_BINARY_DIR}/${NVGT_DEPS_NAME}.zip")
	file(WRITE "${dir}/timestamp" "${latest}")
endfunction()

function(nvgt_build_deps dir)
	if(NVGT_TARGET STREQUAL "windows")
		set(triplet x64-windows)
	elseif(NVGT_TARGET STREQUAL "macos")
		set(triplet arm64-osx)
	elseif(NVGT_TARGET STREQUAL "ios")
		set(triplet arm64-ios)
	elseif(NVGT_TARGET STREQUAL "android")
		set(triplet arm64-android)
	elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
		set(triplet arm64-linux)
	else()
		set(triplet x64-linux)
	endif()
	find_package(Python3 REQUIRED COMPONENTS Interpreter)
	execute_process(COMMAND "${Python3_EXECUTABLE}" -c "import sys; sys.path.insert(0, sys.argv[1]); import build_dependencies; build_dependencies.build(sys.argv[2], out_dir = sys.argv[3])" "${CMAKE_SOURCE_DIR}/vcpkg" ${triplet} "${dir}" RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "Building NVGT's dependencies for ${triplet} failed.")
	endif()
endfunction()

if(NVGT_DEPS STREQUAL "build")
	nvgt_build_deps("${NVGT_DEPS_DIR}")
elseif(NVGT_DEPS STREQUAL "download")
	nvgt_download_deps("${NVGT_DEPS_DIR}")
endif()
if(NOT EXISTS "${NVGT_DEPS_DIR}/include")
	message(FATAL_ERROR "NVGT's dependencies were not found in ${NVGT_DEPS_DIR}. Download https://nvgt.dev/${NVGT_DEPS_NAME}.zip and extract it there, set NVGT_DEPS_PATH to where they are, or use NVGT_DEPS=build to build them with vcpkg.")
endif()

set(NVGT_DEPS_LIB_DIRS "${NVGT_DEPS_DIR}/lib")
set(NVGT_DEPS_DEBUG_LIB_DIRS "${NVGT_DEPS_DIR}/debug/lib" "${NVGT_DEPS_DIR}/lib")
if(NVGT_TARGET STREQUAL "windows")
	list(PREPEND NVGT_DEPS_LIB_DIRS "${NVGT_DEPS_DIR}/bin")
	set(NVGT_DEPS_DEBUG_LIB_DIRS "${NVGT_DEPS_DIR}/debug/bin" "${NVGT_DEPS_DIR}/debug/lib" ${NVGT_DEPS_LIB_DIRS})
endif()

# Sets out to a list of things to link for the given library names. A name that is a target is passed through. Any other name found in the dependencies folder becomes an imported target with release and debug locations, and anything else, such as a system library like user32 or m, is left for the linker to find. A name can be a file name such as libcurl.a to pick a specific file, optionally with the leading colon GNU ld uses for that.
function(nvgt_dep_libraries out)
	set(result)
	foreach(name IN LISTS ARGN)
		if(TARGET "${name}" OR name MATCHES "^(-|\\$<)")
			list(APPEND result "${name}")
			continue()
		endif()
		string(REGEX REPLACE "^:" "" file_name "${name}")
		set(target "nvgtdep::${file_name}")
		if(NOT TARGET "${target}")
			unset(release_location)
			unset(debug_location)
			find_library(release_location NAMES "${file_name}" PATHS ${NVGT_DEPS_LIB_DIRS} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
			find_library(debug_location NAMES "${file_name}" PATHS ${NVGT_DEPS_DEBUG_LIB_DIRS} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
			if(NOT release_location)
				list(APPEND result "${file_name}")
				continue()
			endif()
			if(release_location MATCHES "\\.(so|dylib)(\\.[0-9.]+)?$")
				add_library("${target}" SHARED IMPORTED GLOBAL)
				if(NVGT_TARGET STREQUAL "linux")
					set_target_properties("${target}" PROPERTIES IMPORTED_NO_SONAME TRUE) # Link with -l, so a library without a soname is recorded by its name rather than its full path. On Android Gradle only packages shared libraries linked by their full path.
				endif()
			elseif(release_location MATCHES "\\.a$")
				add_library("${target}" STATIC IMPORTED GLOBAL)
			else()
				add_library("${target}" UNKNOWN IMPORTED GLOBAL)
			endif()
			set_target_properties("${target}" PROPERTIES IMPORTED_LOCATION "${release_location}" IMPORTED_LOCATION_DEBUG "${debug_location}")
		endif()
		list(APPEND result "${target}")
	endforeach()
	set(${out} "${result}" PARENT_SCOPE)
endfunction()

# Copies the shared libraries NVGT and its plugins load at runtime from the dependencies folder into release/lib.
function(nvgt_copy_dep_runtime_libraries)
	set(commands)
	foreach(name IN LISTS ARGN)
		if(NVGT_TARGET STREQUAL "windows")
			set(file_name "${name}.dll")
		elseif(APPLE)
			set(file_name "lib${name}.dylib")
		else()
			set(file_name "lib${name}.so")
		endif()
		foreach(config release debug)
			unset(${config}_file)
			set(dirs ${NVGT_DEPS_LIB_DIRS})
			if(config STREQUAL "debug")
				set(dirs ${NVGT_DEPS_DEBUG_LIB_DIRS})
			endif()
			find_file(${config}_file NAMES "${file_name}" PATHS ${dirs} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
		endforeach()
		if(release_file)
			list(APPEND commands COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<IF:$<CONFIG:Debug>,${debug_file},${release_file}>" "${NVGT_RELEASE_DIR}/lib/${file_name}")
		endif()
	endforeach()
	add_custom_target(nvgt_copy_libs ALL COMMAND "${CMAKE_COMMAND}" -E make_directory "${NVGT_RELEASE_DIR}/lib" ${commands} COMMENT "Copying shared libraries to release/lib" VERBATIM)
endfunction()
