// AI generated tests for audio_node_chain, using an engine without a device so that nothing is played.
void test_audio_node_chain_ordering() {
	audio_engine e(AUDIO_ENGINE_NO_DEVICE, 44100, 2);
	audio_node_chain c(null, e.endpoint, e);
	audio_low_pass_filter a(1000, 2, e);
	audio_high_pass_filter b(100, 2, e);
	audio_notch_filter n(500, 1, e);
	audio_peak_filter p(1000, 3, 1, e);
	assert(c.add_node(a) and c.add_node(b) and c[0] is a and c[1] is b, "add_node without a node to insert after appends");
	assert(c.add_node(p, c.node_count - 1) and c.last is p, "inserting after the last index appends");
	assert(c.add_node(n, -1) and c.first is n and c.node_count == 4, "inserting after index -1 puts the node first");
	assert(!c.add_node(audio_notch_filter(500, 1, e), 4) and !c.add_node(audio_notch_filter(500, 1, e), -2), "out of range indexes are refused");
	assert(c.find(a) == 1 and c.remove_node(a) and c.find(a) == -1 and c.remove_node(0) and c.node_count == 2, "removing nodes");
	assert(c.clear() and c.node_count == 0 and c.endpoint is e.endpoint, "clearing keeps the endpoint");
}
void test_audio_node_chain_operators() {
	audio_engine e(AUDIO_ENGINE_NO_DEVICE, 44100, 2);
	audio_node_chain c(null, e.endpoint, e);
	audio_low_pass_filter a(1000, 2, e);
	audio_high_pass_filter b(100, 2, e);
	audio_peak_filter p(1000, 3, engine: e); // Named so that q keeps its default.
	c += a;
	assert(c.node_count == 1 and c[0] is a, "+= adds a node");
	c += {b, p};
	assert(c.node_count == 3 and c[1] is b and c[2] is p, "+= with a list adds them in order");
	c -= b;
	assert(c.node_count == 2 and c.find(b) < 0, "-= removes a node");
	assert(c.add_nodes({b}) and c.last is b, "add_nodes");
	assert(p.q > 0.7 and p.q < 0.71 and p.frequency == 1000 and p.gain == 3, "a peak filter takes its frequency first and defaults q");
	audio_notch_filter n(60, 5, e);
	assert(n.frequency == 60 and n.q == 5, "a notch filter takes its frequency first");
	audio_low_shelf_filter ls(200, -6, 1, e);
	assert(ls.frequency == 200 and ls.gain == -6 and ls.q == 1, "shelf argument order");
	audio_splitter_node s(e);
	assert(s.get_output_channels(0) == 2 and s.output_bus_count == 2, "a splitter defaults to the engine's channels");
}
