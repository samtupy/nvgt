void test_datetime_add_months_years_keeps_subseconds() {
	datetime d(2026, 1, 15, 10, 30, 15, 123, 456);
	d.add_months(1);
	assert(d.month == 2 and d.millisecond == 123 and d.microsecond == 456);
	d.add_years(1);
	assert(d.year == 2027 and d.millisecond == 123 and d.microsecond == 456);
}
void test_datetime_diff_months() {
	datetime a(2020, 6, 15), b(2026, 6, 15), c(2026, 6, 14);
	assert(a.diff_months(b) == 72);
	assert(b.diff_months(a) == 72);
	assert(a.diff_months(c) == 71);
	datetime e(2020, 11, 15), f(2026, 3, 20);
	assert(e.diff_months(f) == 64);
	datetime g(2026, 1, 1), h(2026, 3, 15, 12, 30, 45);
	assert(g.diff_months(h) == 2);
}
void test_datetime_diff_years() {
	datetime a(2020, 6, 15), b(2026, 6, 15), c(2026, 6, 14);
	assert(a.diff_years(b) == 6.0);
	assert(b.diff_years(a) == 6.0);
	assert(a.diff_years(c) > 5.99 and a.diff_years(c) < 6.0);
	datetime d(2026, 1, 1), e(2026, 7, 2);
	assert(d.diff_years(e) > 0.49 and d.diff_years(e) < 0.51);
	datetime f(2024, 2, 29), g(2028, 2, 29);
	assert(f.diff_years(g) == 4.0);
}
