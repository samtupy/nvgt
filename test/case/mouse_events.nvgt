int mouse_events_button = -1, mouse_events_clicks = 0;
float mouse_events_x = 0, mouse_events_rel_x = 0, mouse_events_wheel_y = 0;
class mouse_events_listener : engine_mouse_button_event_listener {
	int releases = 0;
	bool on_mouse_button_up(int button, int clicks) {
		releases++;
		return true;
	}
}
void mouse_events_on_down(int button, int clicks) {
	mouse_events_button = button;
	mouse_events_clicks = clicks;
}
void mouse_events_on_move(float x, float y, float relative_x, float relative_y) {
	mouse_events_x = x;
	mouse_events_rel_x += relative_x;
}
void mouse_events_on_wheel(float x, float y) {
	mouse_events_wheel_y += y;
}
void mouse_events_on_up_never(int button, int clicks) {
	assert(false); // The object listener before this one handles the event.
}

void test_mouse_events() {
	assert(on_mouse_button_down += mouse_events_on_down);
	assert(!(on_mouse_button_down += mouse_events_on_down));
	assert(on_mouse_move += mouse_events_on_move);
	assert(on_mouse_wheel += mouse_events_on_wheel);
	on_mouse_button_down(1, 2);
	assert(mouse_events_button == 1 and mouse_events_clicks == 2);
	on_mouse_move(10, 20, -5, 0);
	on_mouse_move(5, 20, -5, 0);
	assert(mouse_events_x == 5 and mouse_events_rel_x == -10);
	on_mouse_wheel(0, 1.5);
	assert(mouse_events_wheel_y == 1.5);
	mouse_events_listener l;
	assert(on_mouse_button_up += l);
	assert(on_mouse_button_up += mouse_events_on_up_never);
	on_mouse_button_up(3, 1);
	assert(l.releases == 1);
	assert(on_mouse_button_up.find(l) == 0);
	on_mouse_button_down.clear();
	on_mouse_button_up.clear();
	on_mouse_move.clear();
	on_mouse_wheel.clear();
	assert(on_mouse_move.count == 0);
}
