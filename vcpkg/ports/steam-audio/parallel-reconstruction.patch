+bool SimulationManager::reconstructAndPartitionInParallel(int numChannels, int numSamples)
+{
+    PROFILE_FUNCTION();
+
+    if (mThreadReconstructors.empty() || mIndirectType != IndirectEffectType::Convolution || mSceneType == SceneType::RadeonRays)
+        return false;
+
+    // Each source's impulse response is independent of the others, so reconstructing and partitioning them, which
+    // otherwise takes most of a reflection simulation once there are many sources, is shared across the thread pool.
+    // generateDistanceCorrectionCurves() has collected one correction curve per enabled source, in the same order.
+    mJobGraph.reset();
+
+    auto curveIndex = 0;
+    for (auto& source : mSourceData[0])
+    {
+        if (!source->reflectionInputs.enabled)
+            continue;
+
+        auto data = source.get();
+        auto curve = mDistanceAttenuationCorrectionCurves[curveIndex++];
+        mJobGraph.addJob([this, data, curve, numChannels, numSamples](int threadId, std::atomic<bool>& cancel)
+        {
+            const EnergyField* energyField = data->reflectionState.accumEnergyField.get();
+            ImpulseResponse* impulseResponse = data->reflectionState.impulseResponse.get();
+            mThreadReconstructors[threadId]->reconstruct(1, &energyField, &curve, &data->reflectionInputs.airAbsorptionModel,
+                                                         &impulseResponse, mSharedData->reflection.reconstructionType,
+                                                         mSharedData->reflection.duration, mSharedData->reflection.order);
+
+            if (!data->reflectionState.validSimulationData)
+                return;
+
+            mThreadPartitioners[threadId]->partition(*impulseResponse, numChannels, numSamples, *data->reflectionOutputs.overlapSaveFIR.writeBuffer);
+            data->reflectionOutputs.overlapSaveFIR.commitWriteBuffer();
+            data->reflectionOutputs.numChannels = numChannels;
+            data->reflectionOutputs.numSamples = numSamples;
+        });
+    }
+
+    if (curveIndex > 0)
+        mThreadPool->process(mJobGraph);
+
+    return true;
+}
