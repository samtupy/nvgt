+void BroadPhaseQuadTree::CastRays(uint inNumRays, const RayCast *inRays, RayCastBodyCollector *const *ioCollectors, const BroadPhaseLayerFilter &inBroadPhaseLayerFilter, const ObjectLayerFilter &inObjectLayerFilter) const
+{
+	JPH_PROFILE_FUNCTION();
+
+	JPH_ASSERT(mMaxBodies == mBodyManager->GetMaxBodies());
+
+	// Prevent this from running in parallel with node deletion in FrameSync(), see notes there. The lock is shared, but taking it for every ray
+	// still writes to the same cache line from every thread, which limits how well ray casting from many threads scales.
+	shared_lock lock(mQueryLocks[mQueryLockIdx]);
+
+	for (uint i = 0; i < inNumRays; ++i)
+	{
+		const RayCast &ray = inRays[i];
+		RayCastBodyCollector &collector = *ioCollectors[i];
+
+		// Loop over all layers and test the ones that could hit
+		for (BroadPhaseLayer::Type l = 0; l < mNumLayers; ++l)
+		{
+			const QuadTree &tree = mLayers[l];
+			if (tree.HasBodies() && inBroadPhaseLayerFilter.ShouldCollide(BroadPhaseLayer(l)))
+			{
+				tree.CastRay(ray, collector, inObjectLayerFilter, mTracking);
+				if (collector.ShouldEarlyOut())
+					break;
+			}
+		}
+	}
+}
